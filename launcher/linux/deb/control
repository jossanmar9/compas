Installed-Size: @MIDA@
Depends: php-cli, php-sqlite3, php-mbstring, libcap2-bin
Recommends: ca-certificates, openssl, libnss-mdns, libnss3-tools, php-xml, xdg-utils, python3-gi, gir1.2-gtk-3.0, gir1.2-webkit2-4.1 | gir1.2-webkit2-4.0
